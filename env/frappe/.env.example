# Local-development placeholders only. Copy to .env (gitignored) and change the passwords:
#   cp .env.example .env
# Password of the PostgreSQL superuser (postgres) in the db container.
DB_ROOT_PASSWORD=change-me-local-only
ADMIN_PASSWORD=change-me-local-only
SITE_NAME=lw.localhost
# Host port the site is served on (http://localhost:<port>). Change it if the port is taken.
FRAPPE_HTTP_PORT=8082
# version-16 because leapwell_shukhee_integration requires Python >= 3.14 (matches docker/backend-v16).
# spice_next_core's README targets v15 and frappe_theme@development on v16 is unverified: first run may need fixes.
# A release tag (latest v16 release on 2026-11-19), so every machine builds the same Frappe. Use `version-16`
# to follow the tip of the v16 branch instead.
FRAPPE_BRANCH=v16.60.2
