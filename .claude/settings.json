{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh auth status)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python3 -m scripts.sdlc.repos:*)",
      "Bash(python3 -m scripts.workspace.doctor:*)",
      "Bash(python3 scripts/sdlc/check_issue.py:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/sdlc/guard_tool.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
